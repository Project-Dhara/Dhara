# Set to true to make the Metadata Workspace step's "Save & continue to
# classification" a pure click-through: it skips the real
# /api/catalogue/push and /api/catalogue/batch-push calls (which need GCS
# credentials and a database connection) and moves straight to
# Classification as if the push succeeded. The real push code is untouched
# and still runs when this is false/unset — useful for demoing the console
# UI end to end in an environment without GCS/DB set up.
VITE_ENABLE_CLICK_THROUGH=false
