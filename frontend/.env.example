# Set to true to make the Metadata Workspace step's "Save & continue to
# classification" a pure click-through: it skips the real
# /api/catalogue/batch-push calls (which need a
# database connection, and GCS when ENABLE_GCS=true) and moves straight to
# Classification as if the push succeeded. The real push code is untouched
# and still runs when this is false/unset — useful for demoing the console
# UI end to end without writing to Neon.
VITE_ENABLE_CLICK_THROUGH=false

# Optional public origin for copy-paste API/MCP links when the browser
# origin is not the hostname agents should use (e.g. behind a CDN).
# NEXT_PUBLIC_APP_ORIGIN=https://catalogue.example.gov.in
