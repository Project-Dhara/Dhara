{
  "name": "dhara-desktop",
  "productName": "Dhara",
  "version": "0.1.4",
  "description": "Dhara Desktop — local data stewardship toolkit for Windows (bundled runtime)",
  "author": "Data DHARA",
  "license": "Apache-2.0",
  "main": "dist/main/index.js",
  "private": true,
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "fetch-deps": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-win-deps.ps1",
    "prepare-backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-backend.ps1",
    "prepare-frontend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-frontend.ps1",
    "pack": "npm run build && electron-builder --dir --win --x64",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1"
  },
  "build": {
    "appId": "org.ekstep.datadhara.desktop",
    "productName": "Dhara",
    "copyright": "Copyright © Data DHARA",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "asar": true,
    "files": [
      "dist/**/*",
      "resources/logo.png",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "resources/win-x64",
        "to": "win-x64",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/helpers",
        "to": "helpers",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/logo.png",
      "artifactName": "DharaSetup-${version}-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dhara",
      "license": "../LICENSE",
      "include": "scripts/installer.nsh",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
