ANTHROPIC_API_KEY=your_anthropic_api_key_here
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Local/dev: leave false so catalogue push writes to Neon without GCS.
# Production: set true and fill GCS_BUCKET_NAME (plus GCP credentials).
ENABLE_GCS=false
GCS_BUCKET_NAME=your_gcs_bucket_name_here

# Set to 1/true to run entirely without Claude: table structure is inferred
# heuristically instead of via LLM, and catalogue enrichment/classification/
# grouping features fall back to empty/default values. ANTHROPIC_API_KEY is
# not required in this mode.
SKIP_LLM=false
