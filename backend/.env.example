ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Local Docker Postgres (Option A — docker compose up -d postgres):
DATABASE_URL=postgresql://dhara:dhara_local_password@localhost:5432/dhara
# Cloud / Neon instead (use sslmode=require):
# DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Local/dev: leave false so catalogue push skips Excel uploads to GCS.
# Production: set true and fill GCS_BUCKET_NAME (plus GCP credentials).
ENABLE_GCS=false
GCS_BUCKET_NAME=your_gcs_bucket_name_here

# Set to 1/true to run entirely without Claude: table structure is inferred
# heuristically instead of via LLM, and catalogue enrichment/classification/
# grouping features fall back to empty/default values. ANTHROPIC_API_KEY is
# not required in this mode.
SKIP_LLM=false

# Secret used to sign login JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_random_secret

# Dev: self-serve signup (POST /api/signup) is on by default. Set to false
# once this stops being a dev deployment, to require admin-provisioned
# accounts only (see create_user.py).
ENABLE_SIGNUP=true
