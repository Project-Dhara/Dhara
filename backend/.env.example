# LLM keys are configured in the app (Settings → LLM). Server-side
# ANTHROPIC_API_KEY / OPENAI_API_KEY are no longer used for extraction,
# metadata fill, NCO matching, or PDF AI — paste a key in Settings instead.
# (Optional legacy vars may still appear in older deploys; leave unset.)

# Local Docker Postgres (Option A — docker compose up -d postgres):
# Image: pgvector/pgvector:pg16 (Stage 6 semantic_embeddings).
DATABASE_URL=postgresql://dhara:dhara_local_password@localhost:5432/dhara
# Cloud / Neon instead (use sslmode=require; enable the pgvector extension):
# DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Embedding width for semantic_embeddings.vector (common small models = 1536)
# EMBEDDING_DIM=1536

# Object storage: local (default) or gcs. Misconfigured GCS fails loudly.
STORAGE_BACKEND=local
# STORAGE_LOCAL_PATH=data/object_store
# ENABLE_GCS=true
# GCS_BUCKET_NAME=your_gcs_bucket_name_here

# Server-only Fernet key for encrypting LLM API keys stored in Postgres (Settings UI).
# Users paste provider keys in the app — not here. If unset, local dev auto-creates
# data/.llm_credentials_fernet_key. Set explicitly in production (Render/K8s secrets).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_CREDENTIALS_KEY=

# Force mock LLM provider for tests (no real API calls).
# DHARA_LLM_PROVIDER=mock

# Auth
JWT_SECRET=change_me_to_a_random_secret
ENABLE_SIGNUP=true

# Schema is owned by Alembic (alembic upgrade head). Request-time DDL is off.
DISABLE_REQUEST_TIME_DDL=true

# Remote MCP at /mcp (Streamable HTTP on the same backend port).
# Default jwt — Bearer token required; use off only for trusted demos.
MCP_HTTP_AUTH=off               # off = Claude/Cursor URL connect; jwt|token to lock
# MCP_AUTH_TOKEN=               # required when MCP_HTTP_AUTH=token

# PDF grouping tuning (optional)
# PDF_GROUP_DISTANCE=0.42
# PDF_GROUP_TOP_K=8

# PDF extraction / validation worker pools (optional)
# PDF_CPU_WORKERS=           # PyMuPDF process-pool size (default: min(cpus, RAM/1GB, 8))
# PDF_EXTRACT_CHUNK_PAGES=8  # pages per worker task (smaller = more progress updates)
# PDF_EXTRACT_TEXT_STRATEGY= # set to 1 to also run pymupdf text strategy (slower)
# PDF_OPENAI_WORKERS=12      # concurrent LLM validation calls (I/O-bound)
# PDF_LLM_BATCH_SIZE=6       # pages per LLM validation request
# PDF_LLM_PROMPT_MAX_ROWS=25 # rows per candidate grid in the LLM prompt
