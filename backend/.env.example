# LLM keys are configured in the app (Settings → LLM). Server-side
# ANTHROPIC_API_KEY / OPENAI_API_KEY are no longer used for extraction,
# metadata fill, NCO matching, or PDF AI — paste a key in Settings instead.
# (Optional legacy vars may still appear in older deploys; leave unset.)

# Local Docker Postgres (Option A — docker compose up -d postgres):
# Image: pgvector/pgvector:pg16 (Stage 6 semantic_embeddings).
DATABASE_URL=postgresql://dhara:dhara_local_password@localhost:5432/dhara
# Cloud / Neon instead (use sslmode=require; enable the pgvector extension):
# DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Embedding width for semantic_embeddings.vector (common small models = 1536)
# EMBEDDING_DIM=1536

# Local/dev: leave false so catalogue push skips Excel uploads to GCS.
# Production: set true and fill GCS_BUCKET_NAME (plus GCP credentials).
ENABLE_GCS=false
GCS_BUCKET_NAME=your_gcs_bucket_name_here
# Optional local blob dir (app.storage.local.LocalFileStore)
# STORAGE_LOCAL_PATH=data/object_store

# After ``alembic upgrade head``, disable request-time DDL:
# DISABLE_REQUEST_TIME_DDL=true

# Auth
JWT_SECRET=change_me_to_a_random_secret
ENABLE_SIGNUP=true

# Remote MCP at /mcp (Streamable HTTP on the same backend port).
# MCP_HTTP_AUTH=off|jwt|token  (default off — copy-paste URL works for agents)
# MCP_AUTH_TOKEN=               # required when MCP_HTTP_AUTH=token; also accepted with jwt
# MCP_HTTP_AUTH=jwt

# PDF grouping tuning (optional)
# PDF_GROUP_DISTANCE=0.42
# PDF_GROUP_TOP_K=8
