# MEITY-empanelled LLM API key (Anthropic-compatible endpoint), optional if you
# paste a key in Settings instead:
ANTHROPIC_API_KEY=your_meity_empanelled_api_key_here

# Optional: MEITY-empanelled / OpenAI-compatible key for PDF LLM path + embeddings
# OPENAI_API_KEY=your_meity_empanelled_openai_compatible_key_here

# Local Docker Postgres (Option A — docker compose up -d postgres):
# Image: pgvector/pgvector:pg16 (Stage 6 semantic_embeddings).
DATABASE_URL=postgresql://dhara:dhara_local_password@localhost:5432/dhara
# Cloud / Neon instead (use sslmode=require; enable the pgvector extension):
# DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Embedding width for semantic_embeddings.vector (common small models = 1536)
# EMBEDDING_DIM=1536

# Local/dev: leave false so catalogue push skips Excel uploads to GCS.
# Production: set true and fill GCS_BUCKET_NAME (plus GCP credentials).
ENABLE_GCS=false
GCS_BUCKET_NAME=your_gcs_bucket_name_here

# Prefer leaving the Settings LLM key empty (or omitting OPENAI_/ANTHROPIC_
# keys) for heuristic mode: Excel uses structural extract; PDF uses PyMuPDF
# and accepts ambiguous pages heuristically with human_review_needed.
# SKIP_LLM remains for legacy scripts; the live Excel path keys off the
# request header / Settings key.
SKIP_LLM=false

# Secret used to sign login JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_random_secret

# Dev: self-serve signup (POST /api/signup) is on by default. Set to false
# once this stops being a dev deployment, to require admin-provisioned
# accounts only (see create_user.py).
ENABLE_SIGNUP=true
